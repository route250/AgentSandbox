{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["I4S"],
  "provider": {
    "I4S": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "I4S",
      "options": {
        "baseURL": "http://192.168.1.40:8080/v1"
      },
      "models": {
        "gemma-4-26b-a4b-it-qat": {
          "name": "gemma-4-26B-A4B",
          "limit": {
            "context": 102400,
            "output": 102400
          }
        },
        "ornith-1.5-35b-a3b-rocmfp4": {
          "name": "ornith-1.5-35b-a3b-rocmfp4",
          "limit": {
            "context": 102400,
            "output": 102400
          }
        },
	"qwen3.8-27b-rocmfp4": {
	  "name": "qwen3.8-27b-rocmfp4",
          "limit": {
            "context": 102400,
            "output": 102400
          }
	}
      }
    }
  },
  "model": "I4S/gemma-4-26b-a4b-it-qat",
  "watcher": {
    "ignore": [
      ".git/**",
      ".svn/**",
      "node_modules/**",
      ".venv/**",
      "dist/**",
      "build/**",
      "**/.DS_Store",
      "*.db",
      "tmp/**"
    ]
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "deny"
    }
  }
}

